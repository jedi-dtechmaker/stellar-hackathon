DATABASE_URL="postgresql://stellardrop:stellardrop@localhost:5432/stellardrop?schema=public"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
USDC_ISSUER="GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5"
# Leave BOTH empty to generate once and persist encrypted in PostgreSQL.
MASTER_ESCROW_PUBLIC_KEY=""
MASTER_ESCROW_SECRET_KEY=""
# Generate each independently: openssl rand -hex 32
ENCRYPTION_KEY=""
JWT_SECRET=""
# Sign in with Freighter on Stellar Testnet; email setup is optional.
EMAIL_PROVIDER="disabled"
# Optional future email sign-in: set EMAIL_PROVIDER=resend and configure these.
RESEND_API_KEY=""
EMAIL_FROM="StellarDrop <hello@your-verified-domain.com>"
# Optional local inbox: set EMAIL_PROVIDER=smtp and EMAIL_FROM to
# StellarDrop <hello@stellardrop.test>, then start Mailpit at http://localhost:8025.
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
# Netlify only: generate separately with openssl rand -hex 32.
WORKER_SECRET=""
# polling for local development; webhook for deployment (requires HTTPS URL).
TELEGRAM_MODE="polling"
TELEGRAM_WEBHOOK_URL=""
ANCHOR_HOME_DOMAIN="testanchor.stellar.org"
WEB_ORIGIN="http://localhost:3000"
PORT="4000"
NODE_ENV="development"
# Explicit proxy hop count, if deploying behind a trusted reverse proxy.
TRUST_PROXY_HOPS="0"
ANCHOR_POLL_INTERVAL_MS="10000"
# Local development uses the separate API. Netlify sets this to an empty value
# so /api requests use the same deployed site.
NEXT_PUBLIC_API_URL="http://localhost:4000"
